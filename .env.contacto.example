# Plantilla para activar formulario de contacto (SMTP)
# Copia este bloque a tu `.env.local` y completa los datos reales.

# Servidor SMTP (Gmail recomendado)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Cuenta remitente (la que enviará los correos)
SMTP_USER=tu_cuenta_gmail@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña normal)
# Requiere 2FA activo en Google.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Correo destino donde recibirás los mensajes del formulario
CONTACT_EMAIL_TO=felipezagu@gmail.com
