# Variables de entorno para Cuéntame un Cuento
#
# COPIA este archivo como `.env` y pon tus claves reales.
# ¡No subas `.env` a ningún repositorio!

# Clave para entrar al panel /admin (elige una fuerte y única)
ADMIN_KEY=

# Firma de la cookie de sesión del admin. Si no la defines se deriva de ADMIN_KEY.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# URL pública (para sitemap.xml y robots.txt)
# SITE_URL=https://cuentameuncuento.cl

# Log de cada request en consola (útil para depurar lentitud)
# REQUEST_LOG=1

# Solo emergencia: permite /admin y /tools desde cualquier host (NO uses en producción pública)
# ALLOW_ADMIN_TOOLS=1

# Clave de la API de Luma (NO compartas este valor)
LUMA_API_KEY=luma-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Formulario de contacto por Gmail/SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE: starttls (recomendado), ssl o none
SMTP_SECURE=starttls
SMTP_USER=tu_cuenta_gmail@gmail.com
# Contraseña de aplicación de Google (16 caracteres)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_EMAIL_TO=destino@gmail.com

