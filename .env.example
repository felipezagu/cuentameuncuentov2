# Variables de entorno para Cuéntame un Cuento
#
# COPIA este archivo como `.env` y pon tus claves reales.
# ¡No subas `.env` a ningún repositorio!

# Clave para entrar al panel /admin (elige una fuerte y única)
ADMIN_KEY=

# Solo emergencia: permite /admin y /tools desde cualquier host (NO uses en producción pública)
# ALLOW_ADMIN_TOOLS=1

# Clave de la API de Luma (NO compartas este valor)
LUMA_API_KEY=luma-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Formulario de contacto (SMTP) ---
# Gmail recomendado:
# 1) Activa 2FA
# 2) Crea App Password para "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta_gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_EMAIL_TO=felipezagu@gmail.com

